{
  "$schema": "https://codesandbox.io/schemas/tasks.json",
  "setupTasks": [
    {
      "name": "Install Dependencies",
      "command": "npm install"
    }
  ],
  "tasks": {
    "start": {
      "name": "Start Expo",
      "command": "expo start --web --port 3000",
      "runAtStart": true,
      "preview": {
        "port": 3000
      }
    },
    "start-tunnel": {
      "name": "Start with Tunnel (for mobile)",
      "command": "expo start --tunnel"
    }
  }
}
